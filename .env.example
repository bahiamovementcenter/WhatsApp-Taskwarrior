# whatsapp-mcp bridge / server settings (see third_party/whatsapp-mcp/README.md)
WHATSAPP_BRIDGE_PORT=8080
WHATSAPP_API_URL=http://localhost:8080/api
WHATSAPP_DB_PATH=third_party/whatsapp-mcp/whatsapp-bridge/store/messages.db
WHATSMEOW_DB_PATH=third_party/whatsapp-mcp/whatsapp-bridge/store/whatsapp.db
WHATSAPP_MCP_TRANSPORT=stdio
WEBHOOK_ENABLED=false
# WHATSAPP_BRIDGE_TOKEN=   # defaults to the generated store/.bridge-token
