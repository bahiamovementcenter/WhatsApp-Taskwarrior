diff --git a/allowlist.go b/allowlist.go
new file mode 100644
index 0000000..b8dbff4
--- /dev/null
+++ b/allowlist.go
@@ -0,0 +1,70 @@
+package main
+
+import (
+	"context"
+	"os"
+	"strings"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+// WHATSAPP_ALLOWED_CHATS limits which chats the bridge keeps messages for: a
+// comma- or newline-separated list of chat JIDs, each optionally followed by
+// "=label" (the label is ignored here; wtw reads the same variable). When it
+// is set, messages from any other chat are neither stored nor printed, and
+// only group chats are recorded by JID and name (so they can be found and
+// added to the list). Unset or blank keeps upstream behaviour: every chat is
+// stored. A value with no usable JID stores nothing (fails closed).
+var allowedChats = parseAllowedChats(os.Getenv("WHATSAPP_ALLOWED_CHATS"))
+
+func parseAllowedChats(raw string) map[string]bool {
+	if strings.TrimSpace(raw) == "" {
+		return nil
+	}
+	allowed := map[string]bool{}
+	for _, entry := range strings.FieldsFunc(raw, func(r rune) bool { return r == ',' || r == '\n' }) {
+		jid, _, _ := strings.Cut(entry, "=")
+		if jid = strings.TrimSpace(jid); strings.Contains(jid, "@") {
+			allowed[jid] = true
+		}
+	}
+	return allowed
+}
+
+// chatAllowed reports whether messages from chatJID may be stored.
+func chatAllowed(chatJID string) bool {
+	return allowedChats == nil || allowedChats[chatJID]
+}
+
+// recordOnlyName reports whether a chat outside the allowlist may still be
+// listed by JID and name (groups only, never message content).
+func recordOnlyName(chatJID string) bool {
+	return strings.HasSuffix(chatJID, "@g.us")
+}
+
+// recordJoinedGroupNames lists the groups the account is in by JID and name
+// when the allowlist is set, so `wtw chats --groups` can find a group's JID
+// without anyone posting in it first. Only names are stored, never messages.
+func recordJoinedGroupNames(client *whatsmeow.Client, store *MessageStore, logger waLog.Logger) {
+	if allowedChats == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	groups, err := client.GetJoinedGroups(ctx)
+	if err != nil {
+		logger.Warnf("Failed to list joined groups: %v", err)
+		return
+	}
+	for _, g := range groups {
+		if g == nil || g.Name == "" {
+			continue
+		}
+		if err := store.StoreChatName(g.JID.String(), g.Name); err != nil {
+			logger.Warnf("Failed to store group name: %v", err)
+		}
+	}
+	logger.Infof("Recorded names of %d joined groups", len(groups))
+}
diff --git a/allowlist_test.go b/allowlist_test.go
new file mode 100644
index 0000000..4b42475
--- /dev/null
+++ b/allowlist_test.go
@@ -0,0 +1,114 @@
+package main
+
+import (
+	"testing"
+	"time"
+)
+
+func withAllowedChats(t *testing.T, raw string) {
+	t.Helper()
+	prev := allowedChats
+	allowedChats = parseAllowedChats(raw)
+	t.Cleanup(func() { allowedChats = prev })
+}
+
+func chatRowCount(t *testing.T, ms *MessageStore, jid string) int {
+	t.Helper()
+	var n int
+	if err := ms.db.QueryRow("SELECT COUNT(*) FROM chats WHERE jid = ?", jid).Scan(&n); err != nil {
+		t.Fatalf("count chats: %v", err)
+	}
+	return n
+}
+
+func TestParseAllowedChats(t *testing.T) {
+	if got := parseAllowedChats("  \n "); got != nil {
+		t.Fatalf("blank value must mean no allowlist, got %v", got)
+	}
+	got := parseAllowedChats("1@g.us=Studio Team, 2@g.us\n3@g.us=")
+	if len(got) != 3 || !got["1@g.us"] || !got["2@g.us"] || !got["3@g.us"] {
+		t.Fatalf("unexpected parse: %v", got)
+	}
+	if got := parseAllowedChats("BMC-Neo"); got == nil || len(got) != 0 {
+		t.Fatalf("a value with no JID must allow nothing, got %v", got)
+	}
+	allowedChats = parseAllowedChats("BMC-Neo")
+	t.Cleanup(func() { allowedChats = nil })
+	if chatAllowed("1@g.us") {
+		t.Fatalf("no usable JID must fail closed")
+	}
+}
+
+func TestAllowlist_HistorySyncSkipsOtherChats(t *testing.T) {
+	// Direct chats only: group names are looked up over the network.
+	allowed := phonePN.String()
+	other := "15551112222@s.whatsapp.net"
+	withAllowedChats(t, allowed)
+
+	client := newTestClientWithSelf(&mockLIDStore{}, selfPhone)
+	ms := newTestMessageStore(t)
+	t0 := time.Unix(1710000000, 0)
+
+	handleHistorySync(client, ms, historySyncFor(other, historyTextMsg("o-1", "private", t0)), testLogger())
+	handleHistorySync(client, ms, historySyncFor(allowed, historyTextMsg("a-1", "keep", t0)), testLogger())
+
+	if n := queryMessageCount(ms, other); n != 0 {
+		t.Fatalf("chat outside the allowlist stored %d messages", n)
+	}
+	if n := chatRowCount(t, ms, other); n != 0 {
+		t.Fatalf("direct chat outside the allowlist got a chat row")
+	}
+	if n := queryMessageCount(ms, allowed); n != 1 {
+		t.Fatalf("allowlisted chat: want 1 message, got %d", n)
+	}
+}
+
+func TestAllowlist_StoreMethodsAreNoOpsOutside(t *testing.T) {
+	withAllowedChats(t, "120363000000000001@g.us")
+	ms := newTestMessageStore(t)
+	dm := phonePN.String()
+	now := time.Now()
+
+	if err := ms.StoreChat(dm, "Alice", now); err != nil {
+		t.Fatal(err)
+	}
+	if err := ms.StoreChatName(dm, "Alice"); err != nil {
+		t.Fatal(err)
+	}
+	if err := ms.StoreMessage("m1", dm, "15550000000", "private", now, false, "", "", "", nil, nil, nil, 0, ""); err != nil {
+		t.Fatal(err)
+	}
+	if err := ms.MarkChatRead(dm, now); err != nil {
+		t.Fatal(err)
+	}
+	if n := chatRowCount(t, ms, dm); n != 0 {
+		t.Fatalf("DM outside the allowlist got a chat row")
+	}
+	if n := queryMessageCount(ms, dm); n != 0 {
+		t.Fatalf("DM outside the allowlist stored %d messages", n)
+	}
+
+	// Other groups may be listed by name (to find them), never with messages.
+	other := "120363000000000002@g.us"
+	if err := ms.StoreChatName(other, "Other group"); err != nil {
+		t.Fatal(err)
+	}
+	if n := chatRowCount(t, ms, other); n != 1 {
+		t.Fatalf("group name row missing")
+	}
+}
+
+func TestAllowlist_UnsetKeepsEverything(t *testing.T) {
+	withAllowedChats(t, "")
+	ms := newTestMessageStore(t)
+	dm := phonePN.String()
+	if err := ms.StoreChat(dm, "Alice", time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if err := ms.StoreMessage("m1", dm, "15550000000", "hi", time.Now(), false, "", "", "", nil, nil, nil, 0, ""); err != nil {
+		t.Fatal(err)
+	}
+	if n := queryMessageCount(ms, dm); n != 1 {
+		t.Fatalf("without an allowlist the message must be stored, got %d", n)
+	}
+}
